# credenciais locais
app/config.local.php
app/keys/*
!app/keys/.gitkeep

# cache (token do Drive)
storage/cache/*
!storage/cache/.gitkeep

# uploads dos cursos e biblioteca de modelos
storage/cursos/*
!storage/cursos/.gitkeep
storage/modelos/*
!storage/modelos/.gitkeep
storage/videos/*
!storage/videos/.gitkeep

# logs
logs/
*.log
error_log

# arquivos de sessão PHP
storage/sessions/*
!storage/sessions/.gitkeep
